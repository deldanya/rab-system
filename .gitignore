!data/exports/.gitkeep
!data/templates/.gitkeep

# ── Log server ───────────────────────────────────────────────────
data/server.log
data/server.pid

# ── macOS Launcher (dibuat ulang dengan buat_launcher.sh) ────────
Sistem RAB.app/

