# ── Virtual Environment ──────────────────────────────────────────
venv/
.venv/
env/

# ── Python Cache ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Database (data pribadi — backup terpisah) ─────────────────────
data/rab_database.db
data/rab_database.db-shm
data/rab_database.db-wal

